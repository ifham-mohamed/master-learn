# Existing public client ID is accepted; GOOGLE_CLIENT_ID may be used instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-only values. Never prefix these with NEXT_PUBLIC.
GOOGLE_CLIENT_SECRET=
GOOGLE_SESSION_KEY=
APP_ORIGIN=http://localhost:3100
# Hosted only: set a unique password (20+ characters); username is learner.
APP_ACCESS_PASSWORD=
# Hosted only: directory on a persistent disk. Local default is .local/google-sessions.
GOOGLE_SESSION_DIR=
