# Existing public client ID is accepted; GOOGLE_CLIENT_ID may be used instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-only values. Never prefix these with NEXT_PUBLIC.
GOOGLE_CLIENT_SECRET=
GOOGLE_SESSION_KEY=
APP_ORIGIN=http://localhost:3100
# Optional Node mode password (20+ characters); username is learner. Not used on Pages.
APP_ACCESS_PASSWORD=
# Optional Node mode session directory. Local default is .local/google-sessions.
GOOGLE_SESSION_DIR=

# GitHub Pages needs only NEXT_PUBLIC_GOOGLE_CLIENT_ID as an Actions repository variable.
# Never add server credentials to the Pages deployment.
